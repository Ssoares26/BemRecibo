{
  "name": "bemrecibo-cloudflare",
  "version": "2.0.0",
  "private": true,
  "description": "BemRecibo no Cloudflare Workers: API, PDF e banco D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build:test && node --test \"tests/**/*.test.js\"",
    "build:test": "tsc -p tsconfig.test.json",
    "db:create": "wrangler d1 create bemrecibo",
    "db:migrate": "wrangler d1 migrations apply bemrecibo --remote",
    "db:migrate:local": "wrangler d1 migrations apply bemrecibo --local",
    "db:seed": "wrangler d1 execute bemrecibo --remote --file=seed.sql",
    "db:seed:local": "wrangler d1 execute bemrecibo --local --file=seed.sql",
    "db:export": "python3 scripts/export-sqlite-to-d1.py",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
