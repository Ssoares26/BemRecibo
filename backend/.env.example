# Banco de dados (SQLAlchemy). Padrão: SQLite em backend/bemrecibo.db
# DATABASE_URL=sqlite:///./bemrecibo.db
# Postgres (produção): pip install "psycopg[binary]" e usar:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/bemrecibo

# Origens permitidas no CORS. Use "*" em desenvolvimento e a URL do
# Cloudflare Pages em produção, ex.: https://bemrecibo.pages.dev
ALLOWED_ORIGINS=*
